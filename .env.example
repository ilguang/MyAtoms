# ========== MyAtoms 环境变量模板 ==========
# 复制本文件为 .env 后填入真实值。不要把 .env 提交到仓库。

# --- PostgreSQL 连接串（必填）---
# 本地开发和 Vercel 部署都需要。推荐 Neon 免费 Postgres：
#   1. 注册 https://neon.tech → 创建项目 → Copy connection string
#   2. Vercel 部署建议用带 -pooler 的连接串（连接池，适配 Serverless）
# 本机自建 Postgres 示例：postgresql://postgres:password@localhost:5432/myatoms
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- LLM 加密主密钥（必填，生产必须配置）---
# AES-256-GCM 加密所有用户 API Key。取前 32 字节使用。
# 生成随机值：node -e "console.log(crypto.randomBytes(32).toString('base64'))"
# 注意：本地与 Vercel 请使用同一个值，否则迁移过来的已存 API Key 无法解密
# （解决办法：进设置页重新填写各模型的 API Key）。
LLM_ENCRYPTION_KEY=change-me-to-a-32-byte-random-string

# --- Playwright（可选）---
# 真实浏览器测试需要 chromium：npx playwright install chromium
# 未安装时生成功能正常，仅自动跳过测试环节（Vercel 等 Serverless 环境即如此）。
# PLAYWRIGHT_BROWSERS_PATH=
